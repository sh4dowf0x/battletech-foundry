<form class="{{cssClass}} combat-vehicle-sheet{{#if isVTOL}} vtol-sheet{{/if}}{{#if hideThirdColumn}} third-column-hidden{{/if}}" autocomplete="off">
  <header class="sheet-header">
    <div class="header-left">
      <input class="name cv-name-input" name="name" type="text" value="{{actor.name}}" placeholder="{{vehicleKindLabel}} Name" />
      <div class="cv-header-meta">
        <span>{{vehicleTypeLabel}}</span>
        <span>{{vehicleTonnage}} Tons</span>
        <span>{{system.vehicle.role}}</span>
      </div>
    </div>
    <div class="header-actions cv-header-actions">
      <div class="cv-header-badge" data-combat-vehicle-drag-handle draggable="true" title="Drag this vehicle to the Company sheet">{{vehicleTypeLabel}}</div>
      <button
        type="button"
        class="header-action-btn{{#if isDazzleMode}} is-active{{/if}}"
        data-header-action="dazzle"
        data-macro-label="Dazzle Mode"
        data-macro-img="icons/magic/light/projectile-beam-yellow.webp"
        draggable="true">Dazzle Mode</button>
    </div>
  </header>

  <section class="cv-body">
    <div class="cv-main">
      <div class="cv-main-top">
        <div class="cv-col cv-col-left">
          <section class="cv-panel">
            <h3>{{vehicleKindLabel}} Data</h3>

            <div class="cv-grid cv-grid-2">
              <div class="cv-field">
                <label>Type</label>
                <input name="system.vehicle.type" type="text" value="{{system.vehicle.type}}" placeholder="Vehicle Type" />
              </div>

              <div class="cv-field">
                <label>Tonnage</label>
                <select name="system.vehicle.tonnage">
                  {{selectOptions tonnageOptions selected=vehicleTonnage}}
                </select>
              </div>
            </div>

            <div class="cv-grid cv-grid-2">
              <div class="cv-field">
                <label>Tech Base</label>
                <input name="system.vehicle.techBase" type="text" value="{{system.vehicle.techBase}}" />
              </div>

              <div class="cv-field">
                <label>Rules Level</label>
                <input name="system.vehicle.rulesLevel" type="text" value="{{system.vehicle.rulesLevel}}" />
              </div>
            </div>

            <div class="cv-grid cv-grid-2">
              <div class="cv-field">
                <label>Role</label>
                <input name="system.vehicle.role" type="text" value="{{system.vehicle.role}}" />
              </div>

              <div class="cv-field">
                <label>Engine Type</label>
                <input name="system.vehicle.engine" type="text" value="{{system.vehicle.engine}}" />
              </div>
            </div>

            <div class="cv-grid cv-grid-2">
              <div class="cv-field">
                <label>Movement Type</label>
                <select name="system.vehicle.movement.type">
                  {{#select system.vehicle.movement.type}}
                    {{#each movementTypeOptions as |type|}}
                      <option value="{{type}}">{{type}}</option>
                    {{/each}}
                  {{/select}}
                </select>
              </div>

              <div class="cv-field">
                <label>BV</label>
                <input name="system.vehicle.bv" type="number" value="{{system.vehicle.bv}}" />
              </div>
            </div>

            <div class="cv-grid cv-grid-2">
              <div class="cv-field">
                <label>{{#if isVTOL}}Flight Movement{{else}}Movement{{/if}}</label>
                <div class="cv-movement-stack">
                  <div class="cv-inline cv-movement-inline">
                    <span class="cv-mini-label">{{#if isVTOL}}Cruise{{else}}C{{/if}}</span>
                    <input class="cv-mini-inline-input" name="system.vehicle.movement.cruise" type="number" value="{{system.vehicle.movement.cruise}}" />
                    <span class="cv-mini-label">{{#if isVTOL}}Flank{{else}}F{{/if}}</span>
                    <input class="cv-mini-inline-input" name="system.vehicle.movement.flank" type="number" value="{{system.vehicle.movement.flank}}" />
                    {{#if isVTOL}}
                      <span class="cv-mini-label">Elevation</span>
                      <input class="cv-mini-inline-input" name="system.vehicle.elevation" type="number" value="{{system.vehicle.elevation}}" min="0" />
                    {{/if}}
                  </div>
                  <div class="cv-movement-status-row">
                    <span class="cv-mini-label">This Turn</span>
                    <span class="cv-mini-label">Moved</span>
                    <span class="cv-move-pill">{{movementStatus.moved}}</span>
                    <span class="cv-mini-label">MP</span>
                    <span class="cv-move-pill">{{movementStatus.mpSpent}}</span>
                    <span class="cv-mini-label">Mode</span>
                    <span class="cv-move-pill">{{movementStatus.mode}}</span>
                  </div>
                  {{#if isVTOL}}
                    <div class="cv-movement-status-row">
                      <span class="cv-mini-label">Effective Cruise</span>
                      <span class="cv-move-pill">{{vtolMovement.effectiveCruise}}</span>
                      <span class="cv-mini-label">Effective Flank</span>
                      <span class="cv-move-pill">{{vtolMovement.effectiveFlank}}</span>
                      {{#if vtolMovement.crashed}}<span class="cv-move-pill">Crashed</span>{{/if}}
                    </div>
                  {{/if}}
                </div>
              </div>
            </div>
          </section>

          <section class="cv-panel cv-panel-loadout">
            <h3>Combat Loadout</h3>

            <div class="cv-drop-zone" data-drop-zone="combat-vehicle-weapons">
              <div class="cv-drop-hint">Drop weapons here.</div>
              <div class="cv-we-table">
                <div class="cv-we-row cv-we-header">
                  <div class="cv-we-col type">Type</div>
                  <div class="cv-we-col loc">Loc</div>
                  <div class="cv-we-col dmg">Dmg</div>
                  <div class="cv-we-col range">Range</div>
                  <div class="cv-we-col ctrl"></div>
                </div>

                {{#each vehicleWeapons as |w|}}
                  <div class="cv-we-row {{#if w.isDestroyed}}is-destroyed{{else}}{{#if w.isMalfunctioned}}is-malfunctioned{{/if}}{{/if}}" data-item-id="{{w._id}}" data-item-uuid="{{w.itemUuid}}" draggable="true">
                    <div class="cv-we-col type">{{w.name}}</div>
                    <div class="cv-we-col loc">
                      <select class="cv-weapon-location" data-item-id="{{w._id}}" aria-label="{{w.name}} location" title="Weapon mounting location">
                        <option value="">—</option>
                        {{selectOptions ../weaponLocationOptions selected=w.locationKey}}
                      </select>
                    </div>
                    <div class="cv-we-col dmg">{{w.system.damage}}</div>
                    <div class="cv-we-col range">{{w.system.range.min}}/{{w.system.range.short}}/{{w.system.range.medium}}/{{w.system.range.long}}</div>
                    <div class="cv-we-col ctrl">
                      {{#if w.isDestroyed}}<span class="cv-weapon-state" title="Destroyed">DEST</span>{{else}}{{#if w.isMalfunctioned}}<button type="button" class="cv-weapon-state cv-clear-malfunction" data-action="clear-vehicle-weapon-malfunction" data-item-id="{{w._id}}" title="Spend the Weapon Attack Phase to clear this malfunction"><i class="fas fa-wrench"></i></button>{{/if}}{{/if}}
                      <a class="item-delete" title="Delete">X</a>
                    </div>
                  </div>
                {{/each}}
              </div>

              <div class="cv-ammo-section">
                <div class="cv-subheading">Ammunition</div>
                {{#if hasAmmoBins}}
                  <div class="cv-ammo-table">
                    <div class="cv-ammo-row cv-ammo-header">
                      <div class="cv-ammo-col type">Type</div>
                      <div class="cv-ammo-col cur">Current</div>
                      <div class="cv-ammo-col tot">Total</div>
                    </div>
                    {{#each ammoBins as |bin|}}
                      <div class="cv-ammo-row" data-ammo-key="{{bin.key}}">
                        <div class="cv-ammo-col type">{{bin.name}}</div>
                        <div class="cv-ammo-col cur">
                          <input name="system.ammoBins.{{bin.key}}.current" type="number" value="{{bin.current}}" min="0" max="{{bin.total}}" />
                        </div>
                        <div class="cv-ammo-col tot">{{bin.total}}</div>
                      </div>
                    {{/each}}
                  </div>
                {{else}}
                  <div class="cv-ammo-empty">No ammunition loaded.</div>
                {{/if}}
              </div>
            </div>
          </section>
        </div>

        <div class="cv-col cv-col-mid">
          <section class="cv-panel">
            <h3>Crew Station</h3>

            <div class="cv-field">
              <label>Crew</label>
              <input name="system.crew.name" type="text" value="{{system.crew.name}}" />
            </div>

            <div class="cv-grid cv-grid-2">
              <div class="cv-field">
                <label>Gunnery</label>
                <input name="system.crew.gunnery" type="number" value="{{system.crew.gunnery}}" />
              </div>

              <div class="cv-field">
                <label>{{#if isVTOL}}Piloting{{else}}Driving{{/if}}</label>
                <input name="system.crew.driving" type="number" value="{{system.crew.driving}}" />
              </div>
            </div>

            <div class="cv-grid cv-grid-2">
              <div class="cv-field">
                <label>{{#if isVTOL}}Co-Pilot Hit{{else}}Commander Hit{{/if}}</label>
                <div class="cv-track">
                  {{#each crewTracks.commander as |p|}}
                    <span class="cv-track-box {{#if p.filled}}filled{{/if}}" data-track="crew.commanderHit" data-value="{{p.n}}">
                      {{p.n}}
                    </span>
                  {{/each}}
                </div>
              </div>

              <div class="cv-field">
                <label>{{#if isVTOL}}Pilot Hit{{else}}Driver Hit{{/if}}</label>
                <div class="cv-track">
                  {{#each crewTracks.driver as |p|}}
                    <span class="cv-track-box {{#if p.filled}}filled{{/if}}" data-track="crew.driverHit" data-value="{{p.n}}">
                      {{p.n}}
                    </span>
                  {{/each}}
                </div>
              </div>
            </div>
          </section>

          <section class="cv-panel cv-panel-portrait">
            <h3>Profile</h3>
            <img class="cv-portrait" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" />
          </section>

          <section class="cv-panel cv-panel-equipment">
            <h3>Equipment Bay</h3>

            <div class="cv-drop-zone cv-equipment-drop-zone" data-drop-zone="combat-vehicle-equipment">
              <div class="cv-drop-hint">Drop mech equipment or ammunition here.</div>

              <div class="cv-eq-grid">
                {{#if hasVehicleEquipment}}
                  {{#each vehicleEquipment as |item|}}
                    <div class="cv-eq-row {{#if item.isAmmo}}is-ammo{{/if}}" data-item-id="{{item._id}}" data-item-uuid="{{item.itemUuid}}">
                      <div class="cv-eq-slot"></div>
                      <div class="cv-eq-main">
                        <div class="cv-eq-name">{{item.name}}</div>
                        {{#if item.isAmmo}}
                          <div class="cv-eq-meta">{{item.ammoName}} / {{item.ammoAmount}} shots</div>
                        {{else}}
                          <div class="cv-eq-meta">{{item.type}}</div>
                        {{/if}}
                      </div>
                      <a class="item-delete cv-eq-delete" title="Delete">X</a>
                    </div>
                  {{/each}}
                {{else}}
                  <div class="cv-eq-empty">No equipment installed.</div>
                {{/if}}
              </div>
            </div>
          </section>

          <section class="cv-panel">
            <h3>Critical Damage</h3>

            {{#if isVTOL}}
            <div class="cv-crit-grid">
              <div class="cv-crit-col">
                <div class="cv-field">
                  <label>Sensor Hits</label>
                  <div class="cv-track">
                    {{#each critTracks.sensor as |p|}}
                      <span class="cv-track-box {{#if p.filled}}filled{{/if}}" data-track="crit.sensorHits" data-value="{{p.n}}">{{p.n}}</span>
                    {{/each}}
                  </div>
                </div>

                <div class="cv-field">
                  <label>Rotor Hits</label>
                  <input name="system.crit.rotorHits" type="number" value="{{system.crit.rotorHits}}" min="0" />
                </div>

                <div class="cv-field">
                  <label>Flight Stabilizer Hits</label>
                  <div class="cv-track">
                    {{#each critTracks.flightStabilizer as |p|}}
                      <span class="cv-track-box {{#if p.filled}}filled{{/if}}" data-track="crit.flightStabilizerHits" data-value="{{p.n}}">{{p.n}}</span>
                    {{/each}}
                  </div>
                </div>
              </div>

              <div class="cv-crit-col">
                <div class="cv-field">
                  <label>Engine Hits</label>
                  <div class="cv-track">
                    {{#each critTracks.engine as |p|}}
                      <span class="cv-track-box {{#if p.filled}}filled{{/if}}" data-track="crit.engineHits" data-value="{{p.n}}">{{p.n}}</span>
                    {{/each}}
                  </div>
                </div>

                <label class="cv-check">
                  <input type="checkbox" name="system.crit.rotorsDestroyed" {{checked system.crit.rotorsDestroyed}} />
                  <span>Rotors Destroyed</span>
                </label>

                <div class="cv-field">
                  <label>Weapon Stabilizers</label>
                  <div class="cv-inline cv-inline-checks">
                    <label class="cv-check"><input type="checkbox" name="system.crit.location.front" {{checked system.crit.location.front}} /><span>Front</span></label>
                    <label class="cv-check"><input type="checkbox" name="system.crit.location.left" {{checked system.crit.location.left}} /><span>Left</span></label>
                    <label class="cv-check"><input type="checkbox" name="system.crit.location.right" {{checked system.crit.location.right}} /><span>Right</span></label>
                    <label class="cv-check"><input type="checkbox" name="system.crit.location.rear" {{checked system.crit.location.rear}} /><span>Rear</span></label>
                  </div>
                </div>
              </div>
            </div>
            {{else}}
            <div class="cv-crit-grid">
              <div class="cv-crit-col">
                {{#if hasTurret}}
                <label class="cv-check">
                  <input type="checkbox" name="system.crit.turretLocked" {{checked system.crit.turretLocked}} />
                  <span>Turret Locked</span>
                </label>
                <div class="cv-inline">
                  <label class="cv-check">
                    <input type="checkbox" name="system.crit.turretJammed" {{checked system.crit.turretJammed}} />
                    <span>Turret Jammed</span>
                  </label>
                  {{#if system.crit.turretJammed}}
                    <button type="button" class="cv-small-action" data-action="clear-vehicle-turret-jam" title="Spend the Weapon Attack Phase to clear the turret jam"><i class="fas fa-wrench"></i> Clear</button>
                  {{/if}}
                </div>
                {{/if}}

                <div class="cv-field">
                  <label>Sensor Hits</label>
                  <div class="cv-track">
                    {{#each critTracks.sensor as |p|}}
                      <span class="cv-track-box {{#if p.filled}}filled{{/if}}" data-track="crit.sensorHits" data-value="{{p.n}}">
                        {{p.n}}
                      </span>
                    {{/each}}
                  </div>
                </div>

                <div class="cv-field">
                  <label>Motive Severity</label>
                  <div class="cv-track">
                    {{#each critTracks.motive as |p|}}
                      <span class="cv-track-box {{#if p.filled}}filled{{/if}}" data-track="crit.motiveHits" data-value="{{p.n}}">
                        {{p.n}}
                      </span>
                    {{/each}}
                  </div>
                </div>

                <div class="cv-field">
                  <label>Driving Modifier</label>
                  <input name="system.crit.motiveDrivingMod" type="number" value="{{system.crit.motiveDrivingMod}}" min="0" max="6" readonly />
                </div>
              </div>

              <div class="cv-crit-col">
                <label class="cv-check">
                  <input type="checkbox" name="system.crit.engineHit" {{checked system.crit.engineHit}} />
                  <span>Engine Hit</span>
                </label>

                <div class="cv-field">
                  <label>Crew Stunned Turns</label>
                  <input name="system.crit.crewStunnedTurns" type="number" value="{{system.crit.crewStunnedTurns}}" min="0" />
                </div>

                <div class="cv-field">
                  <label>Weapon Stabilizers</label>
                  <div class="cv-inline cv-inline-checks">
                    <label class="cv-check">
                      <input type="checkbox" name="system.crit.location.front" {{checked system.crit.location.front}} />
                      <span>Front</span>
                    </label>
                    <label class="cv-check">
                      <input type="checkbox" name="system.crit.location.rear" {{checked system.crit.location.rear}} />
                      <span>Rear</span>
                    </label>
                    <label class="cv-check">
                      <input type="checkbox" name="system.crit.location.left" {{checked system.crit.location.left}} />
                      <span>Left</span>
                    </label>
                    <label class="cv-check">
                      <input type="checkbox" name="system.crit.location.right" {{checked system.crit.location.right}} />
                      <span>Right</span>
                    </label>
                    {{#if hasTurret}}
                      <label class="cv-check">
                        <input type="checkbox" name="system.crit.location.turret" {{checked system.crit.location.turret}} />
                        <span>Turret</span>
                      </label>
                    {{/if}}
                  </div>
                </div>
              </div>
            </div>
            {{/if}}
          </section>
        </div>

        <div class="cv-col cv-col-right">
          {{#unless isVTOL}}
          <section class="cv-panel cv-vehicle-options">
            <h3>Vehicle Options</h3>
            <div class="cv-vehicle-options-row">
              <label class="cv-check" title="Disable for vehicles that do not mount a turret.">
                <input type="checkbox" name="system.vehicle.options.turret" {{checked hasTurret}} />
                <span>Turret</span>
              </label>
            </div>
          </section>
          {{/unless}}

          <section class="cv-panel cv-panel-crit-grid">
            <h3>Armor Diagram</h3>

            {{#if isVTOL}}
              <div class="cv-vtol-structure-summary">
                Internal Structure: <strong>{{structurePerLocation}}</strong> per location
              </div>
            {{/if}}

            <div class="cv-armor-diagram{{#if isVTOL}} cv-vtol-diagram{{/if}}">
              <div class="cv-armor-loc cv-armor-front">
                <input class="cv-armor-diagram-input" name="system.armor.front.max" type="number" value="{{armor.front.max}}" min="0" aria-label="Front armor" title="Front armor" />
                <div class="cv-armor-pips">
                  {{#each armor.front.pips as |p|}}
                    <span class="cv-armor-pip {{#if p.filled}}filled{{/if}}" data-loc="front" data-pip="{{p.n}}"></span>
                  {{/each}}
                </div>
              </div>

              <div class="cv-armor-loc cv-armor-left">
                <input class="cv-armor-diagram-input" name="system.armor.left.max" type="number" value="{{armor.left.max}}" min="0" aria-label="Left armor" title="Left armor" />
                <div class="cv-armor-pips">
                  {{#each armor.left.pips as |p|}}
                    <span class="cv-armor-pip {{#if p.filled}}filled{{/if}}" data-loc="left" data-pip="{{p.n}}"></span>
                  {{/each}}
                </div>
              </div>

              {{#if isVTOL}}
                <div class="cv-armor-loc cv-armor-rotor-left">
                  <input class="cv-armor-diagram-input" name="system.armor.rotor.max" type="number" value="{{armor.rotor.max}}" min="0" aria-label="Rotor armor" title="Rotor armor" />
                  <div class="cv-armor-pips">
                    {{#each armor.rotor.leftPips as |p|}}
                      <span class="cv-armor-pip {{#if p.filled}}filled{{/if}}" data-loc="rotor" data-pip="{{p.n}}"></span>
                    {{/each}}
                  </div>
                </div>
                <div class="cv-armor-loc cv-armor-rotor-right">
                  <div class="cv-armor-pips">
                    {{#each armor.rotor.rightPips as |p|}}
                      <span class="cv-armor-pip {{#if p.filled}}filled{{/if}}" data-loc="rotor" data-pip="{{p.n}}"></span>
                    {{/each}}
                  </div>
                </div>
              {{else}}
                {{#if hasTurret}}
                <div class="cv-armor-loc cv-armor-turret">
                  <input class="cv-armor-diagram-input" name="system.armor.turret.max" type="number" value="{{armor.turret.max}}" min="0" aria-label="Turret armor" title="Turret armor" />
                  <div class="cv-armor-pips">
                    {{#each armor.turret.pips as |p|}}
                      <span class="cv-armor-pip {{#if p.filled}}filled{{/if}}" data-loc="turret" data-pip="{{p.n}}"></span>
                    {{/each}}
                  </div>
                </div>
                {{/if}}
              {{/if}}

              <div class="cv-armor-loc cv-armor-right">
                <input class="cv-armor-diagram-input" name="system.armor.right.max" type="number" value="{{armor.right.max}}" min="0" aria-label="Right armor" title="Right armor" />
                <div class="cv-armor-pips">
                  {{#each armor.right.pips as |p|}}
                    <span class="cv-armor-pip {{#if p.filled}}filled{{/if}}" data-loc="right" data-pip="{{p.n}}"></span>
                  {{/each}}
                </div>
              </div>

              <div class="cv-armor-loc cv-armor-rear">
                <input class="cv-armor-diagram-input" name="system.armor.rear.max" type="number" value="{{armor.rear.max}}" min="0" aria-label="Rear armor" title="Rear armor" />
                <div class="cv-armor-pips">
                  {{#each armor.rear.pips as |p|}}
                    <span class="cv-armor-pip {{#if p.filled}}filled{{/if}}" data-loc="rear" data-pip="{{p.n}}"></span>
                  {{/each}}
                </div>
              </div>

              <div class="cv-structure-loc cv-structure-front">
                {{#each structure.front.pips as |p|}}
                  <span class="cv-structure-pip {{#if p.filled}}filled{{/if}}" data-loc="front" data-pip="{{p.n}}"></span>
                {{/each}}
              </div>

              <div class="cv-structure-loc cv-structure-left">
                {{#each structure.left.pips as |p|}}
                  <span class="cv-structure-pip {{#if p.filled}}filled{{/if}}" data-loc="left" data-pip="{{p.n}}"></span>
                {{/each}}
              </div>

              <div class="cv-structure-loc cv-structure-right">
                {{#each structure.right.pips as |p|}}
                  <span class="cv-structure-pip {{#if p.filled}}filled{{/if}}" data-loc="right" data-pip="{{p.n}}"></span>
                {{/each}}
              </div>

              {{#if isVTOL}}
                <div class="cv-structure-loc cv-structure-rotor">
                  {{#each structure.rotor.pips as |p|}}
                    <span class="cv-structure-pip {{#if p.filled}}filled{{/if}}" data-loc="rotor" data-pip="{{p.n}}"></span>
                  {{/each}}
                </div>
              {{else}}
                {{#if hasTurret}}
                <div class="cv-structure-loc cv-structure-turret">
                  {{#each structure.turret.pips as |p|}}
                    <span class="cv-structure-pip {{#if p.filled}}filled{{/if}}" data-loc="turret" data-pip="{{p.n}}"></span>
                  {{/each}}
                </div>
                {{/if}}
              {{/if}}

              <div class="cv-structure-loc cv-structure-rear">
                {{#each structure.rear.pips as |p|}}
                  <span class="cv-structure-pip {{#if p.filled}}filled{{/if}}" data-loc="rear" data-pip="{{p.n}}"></span>
                {{/each}}
              </div>
            </div>
          </section>
        </div>
      </div>
    </div>
  </section>
</form>

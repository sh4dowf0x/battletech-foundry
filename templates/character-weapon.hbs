<div class="{{cssClass}} atow-item-shell" autocomplete="off">
  <section
    class="atow-item-hero"
    role="presentation"
    style="display:grid; grid-template-columns:minmax(96px, 25%) minmax(0, 1fr); gap:12px; align-items:start;">
    <div style="min-width:96px; max-width:120px;">
      <img
        class="atow-item-art"
        src="{{item.img}}"
        data-edit="img"
        title="{{item.name}}"
        style="width:100%; aspect-ratio:1 / 1; height:auto; display:block;" />
    </div>

    <div class="atow-item-hero-main" style="display:flex; flex-direction:column; gap:8px; min-width:0;">
      <div class="atow-item-kicker">Character Weapon Profile</div>

      <div class="atow-item-title">
        <input name="name" type="text" value="{{item.name}}" placeholder="Weapon Name" />
      </div>

      <div class="atow-item-meta-grid" style="display:grid; grid-template-columns:repeat(3, minmax(0, 1fr)); gap:6px;">
        <div class="atow-field">
          <label>Tech</label>
          <input type="text" name="system.ratings.tech" value="{{system.ratings.tech}}" placeholder="A" />
        </div>

        <div class="atow-field">
          <label>Legality</label>
          <input type="text" name="system.ratings.legality" value="{{system.ratings.legality}}" placeholder="L" />
        </div>

        <div class="atow-field">
          <label>Availability</label>
          <input type="text" name="system.ratings.availability" value="{{system.ratings.availability}}" placeholder="A" />
        </div>
      </div>
    </div>
  </section>

  <section class="atow-card">
    <div class="atow-field-grid compact-4">
      <div class="atow-field">
        <label class="atow-compact-label">Weapon Category</label>
        <select name="system.weaponCategory">
          <option value="">Uncategorized (Legacy Ammo)</option>
          {{selectOptions weaponCategoryChoices selected=system.weaponCategory localize=false}}
        </select>
      </div>

      <div class="atow-field">
        <label class="atow-compact-label">Resource Use</label>
        {{#if resourceProfile.flexible}}
          <select name="system.resourceMode">
            {{selectOptions resourceModeChoices selected=resourceProfile.resourceMode localize=false}}
          </select>
        {{else}}
          <input type="text" value="{{resourceProfile.resourceLabel}}" disabled />
        {{/if}}
      </div>

      {{#if resourceProfile.canUsePps}}
      <div class="atow-field">
        <label class="atow-compact-label">Power Points per Shot (PPS)</label>
        <input type="number" min="0" step="1" name="system.pps" value="{{system.pps}}" />
      </div>

      <div class="atow-field">
        <label class="atow-compact-label">Power Pack</label>
          <select name="system.powerPackId">
            <option value="">— Select Power Pack —</option>
            {{selectOptions powerPackChoices selected=system.powerPackId localize=false}}
          </select>
          {{#unless hasPowerPacks}}<small>No Power Packs in this character's inventory.</small>{{/unless}}
      </div>
      {{/if}}

      {{#if resourceProfile.canUseAmmo}}
      <div class="atow-field">
        <label class="atow-compact-label">Special Ammunition</label>
        <select name="system.ammunitionItemId">
          <option value="">— Standard / Unspecified —</option>
          {{selectOptions ammunitionChoices selected=system.ammunitionItemId localize=false}}
        </select>
        {{#unless hasAmmunitionItems}}<small>Add Ammunition equipment to this character's Gear.</small>{{/unless}}
      </div>
      {{/if}}
    </div>
  </section>

  <section class="atow-card atow-stat-card">
    <div class="atow-stat-table-wrap">
      <table class="atow-stat-table">
        <tr>
          <th>AP</th>
          <th>BD</th>
          <th>Range</th>
          <th>Ammo (Current / Max)</th>
          <th>Cost / Reload</th>
          <th>AFF</th>
          <th>Skill</th>
        </tr>
        <tr>
          <td><input type="text" name="system.damage.ap" value="{{system.damage.ap}}" placeholder="AP" /></td>
          <td><input type="text" name="system.damage.bd" value="{{system.damage.bd}}" placeholder="BD" /></td>
          <td><input type="text" name="system.range" value="{{system.range}}" placeholder="5/20/45/105" title="Short / Medium / Long / Extreme range in meters" /></td>
          <td>
            {{#if resourceProfile.usesAmmo}}
            <div style="display:grid; grid-template-columns:minmax(0, 1fr) auto minmax(0, 1fr); gap:3px; align-items:center;">
              <input type="number" min="0" step="1" name="system.magazine.current" value="{{#if magazine.tracked}}{{magazine.current}}{{/if}}" placeholder="Current" title="Ammunition currently loaded" />
              <span>/</span>
              <input type="number" min="0" step="1" name="system.magazine.max" value="{{#if magazine.tracked}}{{magazine.maximum}}{{/if}}" placeholder="Max" title="Full magazine capacity" />
            </div>
            {{else}}
              <input type="text" value="—" disabled title="This weapon category does not use ammunition" />
            {{/if}}
          </td>
          <td><input type="text" name="system.costReload" value="{{system.costReload}}" placeholder="25" /></td>
          <td><input type="text" name="system.affiliation" value="{{system.affiliation}}" placeholder="Faction / Maker" /></td>
          <td>
            <select name="system.skillKey">
              {{selectOptions skillChoices selected=system.skillKey localize=false}}
            </select>
          </td>
        </tr>
      </table>
    </div>
  </section>

  <section class="atow-item-layout compact">
    <div class="atow-stack">
      <section class="atow-card">
        <div class="atow-field-grid compact-2">
          <div class="atow-field">
            <label class="atow-compact-label">Weapon Mass (kg)</label>
            <input type="number" step="0.01" name="system.mass.weaponKg" value="{{system.mass.weaponKg}}" placeholder="4" />
          </div>

          <div class="atow-field">
            <label class="atow-compact-label">Reload Mass (kg)</label>
            <input type="number" step="0.01" name="system.mass.reloadKg" value="{{system.mass.reloadKg}}" placeholder="-" />
          </div>
        </div>

        <div class="atow-field" style="margin-top:10px;">
          <label class="atow-compact-label">Skill Tie</label>
          <input type="text" value="{{skillTied}}" disabled />
        </div>
      </section>
    </div>

    <div class="atow-stack">
      <section class="atow-card">
        <div class="atow-field">
          <label class="atow-compact-label">Notes</label>
          <textarea
            class="short"
            name="system.notes"
            rows="6"
            placeholder="Special rules, reload quirks, or attack modifiers.">{{system.notes}}</textarea>
        </div>
      </section>
    </div>
  </section>
</div>
